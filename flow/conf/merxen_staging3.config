// Flow staging3, full form (flow/schema/merxen.json): the one Config Path to
// enter on the Flow version. merxen_simple.config stopped including
// staging3.config in the v1.1.1 sync, so no single file carried both.

includeConfig 'merxen.config'     // Apptainer images, CPU-only, caches in the run
includeConfig 'staging3.config'   // Allen WHB reference files on this server

// Legacy clustering, not map_first, for the reason given in
// merxen_simple.config: map_first's preflight needs annotation references that
// are not uploaded to staging3, and refuses the run before any task starts.
params.clustering_squidpy_mode = 'legacy'
