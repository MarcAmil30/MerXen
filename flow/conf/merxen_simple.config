// Flow.bio, simple version (0.2): one end-to-end run per sample.
//
// Used with flow/schema/merxen_simple.json. The form only asks for the sample
// and a few presets; everything below is fixed so users cannot pick a stage
// range that skips or breaks part of the pipeline.

includeConfig 'merxen.config'     // Apptainer images, CPU-only, caches in the run
includeConfig 'staging3.config'   // Allen WHB reference files on this server

// Every run goes from the raw export to spatial domains:
// build -> segment -> enrich -> QC -> MECR -> visualize -> clustering
//       -> MapMyCells -> MENDER
params.start_stage = 'build_spatialdata'
params.stop_stage  = 'mender'
params.mecr_enabled   = true
params.mender_enabled = true
// three annotation figures per section (cell types by markers and by the
// Allen atlas, MENDER domains); listed as outputs in merxen_simple.json
params.annotation_figures_enabled = true

// These three need hand-drawn pial-boundary and tissue-edge GeoJSON files,
// which the simple form does not ask for.
params.spatial_gene_analysis_enabled = false
params.cortical_depth_enabled        = false
params.distance_from_object_enabled  = false

// whole_brain uses the uploaded precomputed stats: no download, minutes.
// region/both download about 38 GB from Allen and build a frontal reference
// on every run (over 2 hours on staging3). The form can override this.
params.mapmycells_reference_mode = 'whole_brain'
