// Flow staging3: the Allen Whole Human Brain (WHB) reference files.
//
// Uploaded once with flowbio on 2026-11-02. Flow stores each upload at
// /media/storage/staging3/uploads/<data id>/<filename>, confirmed from the
// command of execution 429351479341087972. The ids stay fixed unless a file is
// deleted and uploaded again. Another Flow server needs its own copy of this
// file with its own paths.

params {
    // MECR (about 38 GB)
    mecr_whb_neurons_h5ad_path       = "/media/storage/staging3/uploads/561620722172166833/WHB-10Xv3-Neurons-raw.h5ad"
    mecr_whb_nonneurons_h5ad_path    = "/media/storage/staging3/uploads/305927763203472260/WHB-10Xv3-Nonneurons-raw.h5ad"
    mecr_whb_cell_metadata_path      = "/media/storage/staging3/uploads/626009114127570948/cell_metadata.csv"
    mecr_whb_taxonomy_metadata_path  = "/media/storage/staging3/uploads/294013751375016198/cluster_annotation_term.csv"
    mecr_whb_cluster_membership_path = "/media/storage/staging3/uploads/544461751200246681/cluster_to_cluster_annotation_membership.csv"
    // Precomputed MECR count table (1.8 MB, `merxen mecr-count-table`). Once
    // uploaded, set it here: MECR_REFERENCE then reads it instead of the
    // 38 GB above and takes seconds instead of about 30 minutes.
    // mecr_whb_count_table_path     = "/media/storage/staging3/uploads/<data id>/whb_mecr_counts_20240330_SUPC.parquet"

    // Clustering broad cell classes
    clustering_squidpy_whb_marker_lookup_path      = "/media/storage/staging3/uploads/470321146206683464/query_markers.n10.20240221800.json"
    clustering_squidpy_whb_taxonomy_metadata_path  = "/media/storage/staging3/uploads/294013751375016198/cluster_annotation_term.csv"
    clustering_squidpy_whb_cluster_membership_path = "/media/storage/staging3/uploads/544461751200246681/cluster_to_cluster_annotation_membership.csv"

    // MapMyCells whole-brain mapping (8.7 GB precomputed stats)
    mapmycells_whb_marker_lookup_path     = "/media/storage/staging3/uploads/470321146206683464/query_markers.n10.20240221800.json"
    mapmycells_whb_precomputed_stats_path = "/media/storage/staging3/uploads/820517980674790645/precomputed_stats.siletti.training.h5"

    // Gene symbol to Ensembl ID table
    annotation_gene_id_fallback_csv = "/media/storage/staging3/uploads/365181643564267688/gene.csv"
}
