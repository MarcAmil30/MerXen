// Flow staging3: the Allen Whole Human Brain (WHB) reference files, and the
// two settings that machine needs. Pass it as a second Config Path on the
// Flow version, after flow/conf/merxen.config.
//
// Uploaded once with flowbio on 2026-11-02. Flow stores each upload at
// /media/storage/staging3/uploads/<data id>/<filename>, confirmed from the
// command of execution 429351479341087972. The ids stay fixed unless a file is
// deleted and uploaded again. Another Flow server needs its own copy of this
// file with its own paths; flow/conf/flow.site.config.example is the template
// for one kept outside the repository.

params {
    // MECR (about 38 GB). MECR_REFERENCE and MECR_REFERENCE_ATERA both read
    // these when reference_atlas = "whb".
    mecr_whb_neurons_h5ad_path       = "/media/storage/staging3/uploads/561620722172166833/WHB-10Xv3-Neurons-raw.h5ad"
    mecr_whb_nonneurons_h5ad_path    = "/media/storage/staging3/uploads/305927763203472260/WHB-10Xv3-Nonneurons-raw.h5ad"
    mecr_whb_cell_metadata_path      = "/media/storage/staging3/uploads/626009114127570948/cell_metadata.csv"
    mecr_whb_taxonomy_metadata_path  = "/media/storage/staging3/uploads/294013751375016198/cluster_annotation_term.csv"
    mecr_whb_cluster_membership_path = "/media/storage/staging3/uploads/544461751200246681/cluster_to_cluster_annotation_membership.csv"

    // Every reference file above is already uploaded, so no stage should try to
    // fetch the atlas from a Flow worker.
    mecr_auto_download_reference = false

    // Clustering broad cell classes. main.nf:1590 falls back to these whb_*
    // paths when the broad_* ones are null and reference_atlas = "whb".
    clustering_squidpy_whb_marker_lookup_path      = "/media/storage/staging3/uploads/470321146206683464/query_markers.n10.20240221800.json"
    clustering_squidpy_whb_taxonomy_metadata_path  = "/media/storage/staging3/uploads/294013751375016198/cluster_annotation_term.csv"
    clustering_squidpy_whb_cluster_membership_path = "/media/storage/staging3/uploads/544461751200246681/cluster_to_cluster_annotation_membership.csv"

    // MapMyCells whole-brain mapping (8.7 GB precomputed stats)
    mapmycells_whb_marker_lookup_path     = "/media/storage/staging3/uploads/470321146206683464/query_markers.n10.20240221800.json"
    mapmycells_whb_precomputed_stats_path = "/media/storage/staging3/uploads/820517980674790645/precomputed_stats.siletti.training.h5"

    // MapMyCells region mapping: the built region reference
    // region_frontal_a44_a45_a46_a32_acc-3e012822105d82c4 (2.4 GB tar, built on
    // CREATE 2026-10-20, uploaded 2026-11-26). MAPMYCELLS unpacks it into the
    // run cache, so the run neither downloads the 38 GB atlas from Allen S3 nor
    // rebuilds the reference. It matches the default human region settings
    // only; with other mapmycells_region_* settings it is ignored and the
    // reference is built from a download as before.
    mapmycells_region_reference_archive = "/media/storage/staging3/uploads/990681949673367113/mapmycells_region_references_whb_frontal_3e012822.tar"

    // Gene symbol to Ensembl ID table
    annotation_gene_id_fallback_csv = "/media/storage/staging3/uploads/365181643564267688/gene.csv"

    // The reference paths above reach a stage as strings inside its config JSON
    // (Flow blocker 1), so Nextflow never stages them and the container only
    // sees them if the upload tree is bound. nextflow.config:1190 also replaces
    // containerOptions for the two ATERA Cellpose processes with "-C --no-home",
    // which drops any process-wide bind but keeps this param.
    apptainer_bind_paths = "/media/storage"

    // Reservation, not a measurement: the 212 GB default is sized for a whole
    // section, and staging3 is one 32-CPU, 251.7 GB machine, so the request
    // cannot be met beside any other stage. Raise it for a full ATERA section.
    atera_cellpose_segment_memory_gb = 48
}
