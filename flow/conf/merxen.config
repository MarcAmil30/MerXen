// Flow.bio: run every MerXen stage inside its Apptainer image.
//
// Flow runs `nextflow run workflows/main.nf` with no -profile, so Nextflow
// applies the `standard` profile (conf/dwight.config, the authors'
// workstation: no containers, TMPDIR=/srv/storage/MerXen/tmp, 640 GB RAM).
// Flow passes this file with -c (the version's Config Paths), which is read
// after nextflow.config and so overrides those settings.
//
// Images: <container_registry>/<image>:<container_tag>, mapped per stage in
// conf/containers.config. oras:// pulls the .sif images pushed to GHCR.

params {
    container_registry = "oras://ghcr.io/marcamil30"
    // set here too: params from nextflow.config are not visible while this
    // file builds the image names, so without it they end in :null
    container_tag = "0.1.0"
    cellpose_gpu = false
    gpu_process_lock_enabled = false
}

includeConfig '../../workflows/conf/containers.config'

// after containers.config, which sets 32: ProSeg gets 16 CPUs below
params.proseg_num_threads = 16
params.clustering_squidpy_use_gpu = false

// dwight.config points these caches at /media/mathieubo/SSD1/MerXen/mapmycells,
// a disk on the authors' workstation. null makes each stage use
// <outdir>/mapmycells_cache inside the run (rebuilt per run, not shared).
params.mecr_reference_cache_dir = null
params.mapmycells_region_cache_dir = null
params.clustering_squidpy_broad_reference_cache_dir = null

apptainer.enabled    = true
apptainer.autoMounts = true
singularity.enabled  = false
docker.enabled       = false
conda.enabled        = false

// dwight.config points TMPDIR at a folder that only exists on that workstation
env {
    TMPDIR = "/tmp"
}

// workflows/nextflow.config sends some stages to the authors' Slurm partitions
// (htc, dynamic, gpu) and reserves up to 300 GB. Flow staging3 runs Slurm on
// one 32-CPU, 251.7 GB machine without those partitions, so sbatch refused
// the Cellpose jobs. Use the default partition and cap every request at what
// the machine has; the same selectors as nextflow.config, so these win.
process {
    resourceLimits = [cpus: 32, memory: 200.GB]
    withName: "CELLPOSE_SEGMENT" { queue = null; clusterOptions = null }
    withName: "CELLPOSE_NUCLEI_SEGMENT" { queue = null; clusterOptions = null }
    // 16 of the 32 CPUs, so two runs can share the machine; threads to match
    withName: "PROSEG_SEGMENT" { queue = null; clusterOptions = null; cpus = 16 }
    withName: "ENRICH" { queue = null; clusterOptions = null }
    withName: "VIEWER_CACHE" { queue = null; clusterOptions = null }
    withName: "MENDER_COMPUTE" { queue = null; clusterOptions = null }
    withName: "ALIGN" { queue = null; clusterOptions = null }
    withName: "MATERIALIZE_ALIGNMENT" { queue = null; clusterOptions = null }
    // Flow staging3 has no GPU. conf/dwight.config (the standard profile) sets
    // clustering_squidpy_use_gpu = true, which made this stage pull the 10.8 GB
    // merxen-clustering-gpu image even with the form's GPU option off.
    withName: "CLUSTERING_SQUIDPY_COMPUTE" {
        queue = null; clusterOptions = null
        container = { "${params.container_registry}/merxen:${params.container_tag}" }
    }
}
