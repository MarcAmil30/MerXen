// Flow.bio: run every MerXen stage inside its Apptainer image.
//
// Flow runs `nextflow run workflows/main.nf` with no -profile, so Nextflow
// applies the `standard` profile (conf/dwight.config, the authors'
// workstation: no containers, TMPDIR=/srv/storage/MerXen/tmp, 640 GB RAM).
// Flow passes this file with -c (the version's Config Paths), which is read
// after nextflow.config and so overrides those settings.
//
// Images: <container_registry>/<image>:<container_tag>, mapped per stage in
// conf/containers.config. oras:// pulls the .sif images pushed to GHCR.

params {
    container_registry = "oras://ghcr.io/marcamil30"
    cellpose_gpu = false
    gpu_process_lock_enabled = false
}

includeConfig '../../workflows/conf/containers.config'

apptainer.enabled    = true
apptainer.autoMounts = true
singularity.enabled  = false
docker.enabled       = false
conda.enabled        = false

// dwight.config points TMPDIR at a folder that only exists on that workstation
env {
    TMPDIR = "/tmp"
}
