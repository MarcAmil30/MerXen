#!/usr/bin/env bash
# Usage: merxen-link-copy SRC_ZARR DST_ZARR
#
# Give a stage its own copy of an upstream zarr store to add to, so the
# upstream task's output is left as it was. Files are hard-linked, so the copy
# costs no extra space: zarr replaces a chunk or metadata file by writing a new
# file and renaming it over the old name, which never touches the linked
# original. The linked files are made read-only, so a writer that edits a file
# in place fails with "Permission denied" instead of changing the upstream
# store. On a different filesystem it falls back to a plain copy.
#
# Only file modes and times are kept, not owners, ACLs or extended
# attributes: inside a rootless container those cannot be set ("preserving
# permissions ... Invalid argument" on CephFS), and the store needs none.
set -euo pipefail

src=$1
dst=$2

# a task Slurm ran twice in one work folder (sbatch timed out after
# submitting, Nextflow submitted again) finds dst already there
rm -rf "$dst"
mkdir "$dst"
if ! cp -R -P --link "$src/." "$dst/" 2>/dev/null; then
    # start again, so cp never writes into a file still linked to the original
    rm -rf "$dst"
    mkdir "$dst"
    if ! cp -R -P --preserve=mode,timestamps "$src/." "$dst/" 2>/dev/null; then
        # some filesystems (CephFS with ACLs, inside a rootless container)
        # refuse even mode bits; the store needs no particular modes
        rm -rf "$dst"
        mkdir "$dst"
        cp -R -P "$src/." "$dst/"
    fi
fi
find "$dst" -type f -links +1 -exec chmod a-w {} +
