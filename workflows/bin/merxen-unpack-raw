#!/usr/bin/env bash
# Usage: merxen-unpack-raw ARCHIVE DEST_DIR
#
# Unpack a raw MERSCOPE region export or Xenium output bundle that arrives as
# one .tar, .tar.gz, .tgz or .zip file (Flow.bio data are single files) into
# DEST_DIR. An archive holding a single top-level folder unpacks to that
# folder's contents; otherwise its top level is the export itself.
set -euo pipefail
archive=$1; dest=$2
tmp="${dest}.unpack"
rm -rf "$tmp" "$dest"
mkdir -p "$tmp"
python3 - "$archive" "$tmp" <<'PY'
import os, sys, tarfile, zipfile
archive, out = sys.argv[1], sys.argv[2]


def inside(base, path):
    path = os.path.realpath(path)
    return path == base or path.startswith(base + os.sep)


if zipfile.is_zipfile(archive):
    with zipfile.ZipFile(archive) as zf:
        zf.extractall(out)
else:
    with tarfile.open(archive) as tf:
        try:
            tf.extractall(out, filter="data")
        except TypeError:
            # Python without tarfile extraction filters (before 3.12 and the
            # 3.8-3.11 security releases): check each member the way the
            # "data" filter would before extracting.
            base = os.path.realpath(out)
            for m in tf.getmembers():
                dest = os.path.join(out, m.name)
                bad = (
                    os.path.isabs(m.name)
                    or not inside(base, dest)
                    or m.isdev()
                    or (m.issym() and not inside(base, os.path.join(os.path.dirname(dest), m.linkname)))
                    or (m.islnk() and not inside(base, os.path.join(out, m.linkname)))
                )
                if bad:
                    sys.exit(f"merxen-unpack-raw: unsafe member in {archive}: {m.name}")
            tf.extractall(out)
PY
mapfile -t top < <(find "$tmp" -mindepth 1 -maxdepth 1 ! -name "__MACOSX")
if [[ ${#top[@]} -eq 1 && -d ${top[0]} ]]; then
    mv "${top[0]}" "$dest"
    rm -rf "$tmp"
else
    mv "$tmp" "$dest"
fi
