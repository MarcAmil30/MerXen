#!/usr/bin/env python3
"""Annotation figures for one section: marker cell types, Allen cell types, tissue domains.

Usage:
    merxen-annotation-figures --mapmycells-h5ad FILE --mender-cells FILE \
        --sample NAME --out-dir DIR

Inputs are the outputs of the MAPMYCELLS and MENDER_FINALIZE stages for one
platform and segmentation:
  * <sample>_mapmycells_annotated.h5ad: the clustered cells (leiden clusters,
    raw counts in layers["counts"], obsm["spatial"] in microns) with the
    MapMyCells calls in obs (mapmycells_supercluster_name, ...).
  * <sample>_mender_cells.parquet: one row per cell with native_x, native_y
    and mender_domain.

Writes into DIR:
  <sample>_celltypes_markers.png   cells coloured by marker-scored type
  <sample>_celltypes_allen.png     A: cells named against the Allen atlas,
                                   B: how many of each type
  <sample>_tissue_domains.png      C: MENDER domains, D: size and dominant type
  <sample>_annotation_summary.json the counts behind the figures
  <sample>_marker_cluster_types.csv each leiden cluster's marker-scored type

The marker scoring follows the method of the DLPFC write-up: each leiden
cluster's mean log-normalised expression is z-scored across clusters, each
cell type's marker set is averaged, and a cluster takes the best type when its
score is above 0.35, otherwise "Unassigned".
"""
import argparse
import collections
import csv
import json
from pathlib import Path

import matplotlib

matplotlib.use("Agg")
import anndata as ad
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from matplotlib.lines import Line2D
from scipy import sparse

MARKERS = {
    "Excitatory neuron": ["SLC17A7", "RORB", "CUX2", "THEMIS"],
    "Inhibitory neuron": ["GAD1", "GAD2", "PVALB", "SST", "VIP", "LAMP5", "ADARB2"],
    "Oligodendrocyte": ["MBP", "MOBP", "MOG", "ST18", "MAG"],
    "OPC": ["PDGFRA", "CSPG4", "OLIG1", "OLIG2", "GPR17"],
    "Astrocyte": ["AQP4", "SLC1A2", "GJA1"],
    "Microglia": ["CX3CR1", "P2RY12", "C1QA", "APBB1IP"],
    "Vascular": ["CLDN5", "FLT1", "PECAM1", "DCN"],
}
MARKER_COL = {
    "Excitatory neuron": "#d1495b", "Inhibitory neuron": "#f28f3b",
    "Oligodendrocyte": "#00798c", "OPC": "#8bd3c7", "Astrocyte": "#4c9f70",
    "Microglia": "#c77dff", "Vascular": "#edae49", "Unassigned": "#55595f",
}
MIN_SCORE = 0.35
PAL = ["#0f7b8a", "#3d8c5c", "#c9922c", "#c0392b", "#56b6a6", "#8e5bc4", "#e07b2a", "#4f6ea8"]
DOMAIN_PAL = ["#0f7b8a", "#7fb3c8", "#c0392b", "#3d8c5c", "#c9922c", "#8e5bc4", "#e07b2a", "#4f6ea8"]
OTHER = "#d4d2cd"
INK = "#0a0c0f"


def scale_bar(ax, x, y, color, text_color, dark=False):
    """A scale bar of a round length that fits the section, lower right."""
    span = float(x.max() - x.min())
    length = next(v for v in (1000, 500, 200, 100, 50, 20, 10) if v <= span / 3) if span > 30 else 10
    x1, y0 = float(x.max()), float(-y.max())
    pad = 0.04 * span
    ax.plot([x1 - length, x1], [y0 - pad, y0 - pad], color=color, lw=2.2)
    ax.text(x1 - length / 2, y0 - 2.2 * pad, f"{length} µm", color=text_color,
            fontsize=9.5, ha="center", va="top")


def dot_size(n):
    """Dots large enough to see on a 500-cell crop, small enough on 20,000."""
    return float(np.clip(9000.0 / max(n, 1), 1.3, 18.0))


def marker_types(adata):
    X = adata.layers["counts"] if "counts" in adata.layers else adata.X
    X = sparse.csr_matrix(X).astype(np.float32)
    tot = np.asarray(X.sum(1)).ravel()
    tot[tot == 0] = 1
    Xn = sparse.diags(np.median(tot) / tot) @ X
    Xn.data = np.log1p(Xn.data)
    gi = {str(g): i for i, g in enumerate(adata.var_names)}
    clus = np.asarray(adata.obs["leiden"]).astype(str)
    labs = sorted(set(clus), key=lambda s: (0, int(s)) if s.isdigit() else (1, s))
    M = np.vstack([np.asarray(Xn[clus == c].mean(0)).ravel() for c in labs])
    Z = (M - M.mean(0)) / (M.std(0) + 1e-9)
    types = list(MARKERS)
    S = np.vstack([
        Z[:, [gi[g] for g in MARKERS[t] if g in gi]].mean(1)
        if any(g in gi for g in MARKERS[t]) else np.full(len(labs), -np.inf)
        for t in types
    ]).T
    rows, assign = [], {}
    for r, c in enumerate(labs):
        order = np.argsort(-S[r])
        best = S[r, order[0]]
        t = types[order[0]] if best > MIN_SCORE else "Unassigned"
        assign[c] = t
        second = S[r, order[1]] if len(order) > 1 else -np.inf
        rows.append({
            "cluster": c, "cells": int((clus == c).sum()), "cell_type": t,
            "score": round(float(best), 2),
            "margin": round(float(best - second), 2) if np.isfinite(second) else "",
            "markers_in_panel": " ".join(g for g in MARKERS.get(t, []) if g in gi) or "-",
        })
    return np.array([assign[c] for c in clus]), rows


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mapmycells-h5ad", required=True)
    ap.add_argument("--mender-cells", required=True)
    ap.add_argument("--sample", required=True)
    ap.add_argument("--out-dir", required=True)
    args = ap.parse_args()
    out = Path(args.out_dir)
    out.mkdir(parents=True, exist_ok=True)
    name = args.sample

    a = ad.read_h5ad(args.mapmycells_h5ad)
    xy = np.asarray(a.obsm["spatial"], float)
    n = len(xy)
    summary = {"sample": name, "cells": n}
    plt.rcParams.update({"font.size": 10.5, "text.color": "#1b1d1f", "axes.labelcolor": "#1b1d1f",
                         "xtick.color": "#4a4d50", "ytick.color": "#4a4d50"})

    # ---- Figure 2 style: marker-scored types, dark background ------------
    per, cluster_rows = marker_types(a)
    with open(out / f"{name}_marker_cluster_types.csv", "w", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=list(cluster_rows[0]))
        w.writeheader()
        w.writerows(cluster_rows)
    present = [t for t in list(MARKERS) + ["Unassigned"] if (per == t).any()]
    fig, ax = plt.subplots(figsize=(9.2, 8.2), facecolor=INK)
    ax.set_facecolor(INK)
    for t in present:
        m = per == t
        ax.scatter(xy[m, 0], -xy[m, 1], s=dot_size(n), c=MARKER_COL[t], linewidths=0,
                   label=f"{t}  ({m.sum():,})", rasterized=True)
    ax.set_aspect("equal")
    ax.axis("off")
    scale_bar(ax, xy[:, 0], xy[:, 1], "#9aa0a8", "#9aa0a8", dark=True)
    ax.legend(loc="center left", bbox_to_anchor=(1.0, 0.5), frameon=False, markerscale=2.5,
              fontsize=11, labelcolor="#e9e7e2")
    ax.set_title(f"{name}: cell types from marker scoring", color="#e9e7e2", fontsize=13, pad=10)
    fig.savefig(out / f"{name}_celltypes_markers.png", dpi=115, facecolor=INK, bbox_inches="tight")
    plt.close(fig)
    summary["marker_types"] = {t: int((per == t).sum()) for t in present}

    # ---- Figure 3 A + B: Allen cell types (MapMyCells) ---------------------
    col = next((c for c in ("mapmycells_supercluster_name", "mapmycells_class_name") if c in a.obs), None)
    sup = a.obs[col].astype(str).replace({"nan": ""}).to_numpy() if col else np.array([""] * n)
    cnt = collections.Counter(s for s in sup if s)
    top = [t for t, _ in cnt.most_common(8)]
    COL = dict(zip(top, PAL))
    fig, (axA, axB) = plt.subplots(1, 2, figsize=(16.4, 7.6), facecolor="white",
                                   gridspec_kw={"width_ratios": [1.85, 1.0], "wspace": 0.30})
    oth = ~np.isin(sup, top) & (sup != "")
    axA.scatter(xy[oth, 0], -xy[oth, 1], s=dot_size(n), c=OTHER, linewidths=0, rasterized=True)
    for t in top:
        m = sup == t
        axA.scatter(xy[m, 0], -xy[m, 1], s=dot_size(n) * 1.2, c=COL[t], linewidths=0, rasterized=True)
    axA.set_aspect("equal")
    axA.axis("off")
    axA.set_title("A · Every cell named against the Allen atlas", fontsize=13, pad=10, loc="left")
    scale_bar(axA, xy[:, 0], xy[:, 1], "#6a6d70", "#4a4d50")
    axA.legend(handles=[Line2D([], [], marker="o", ls="", ms=7.5, color=COL[t], label=t) for t in top]
               + ([Line2D([], [], marker="o", ls="", ms=7.5, color=OTHER, label="other types")] if oth.any() else []),
               loc="upper left", bbox_to_anchor=(0, 0.0), ncol=2, frameon=False, fontsize=9)
    tot = max(sum(cnt.values()), 1)
    ys = np.arange(len(top))[::-1]
    for i, t in enumerate(top):
        axB.barh(ys[i], 100 * cnt[t] / tot, height=0.62, color=COL[t])
        axB.text(100 * cnt[t] / tot + 1.0, ys[i], f"{cnt[t]:,}", va="center", fontsize=9.5)
    axB.set_yticks(ys)
    axB.set_yticklabels([t if len(t) < 25 else t[:23] + "…" for t in top], fontsize=9.5)
    axB.set_xlabel("share of cells (%)")
    if top:
        axB.set_xlim(0, 100 * cnt[top[0]] / tot * 1.3)
    axB.set_title("B · What it found, and how much", fontsize=13, pad=10, loc="left")
    axB.grid(True, axis="x", color="#e6e4e0", lw=0.7)
    axB.set_axisbelow(True)
    for sp in axB.spines.values():
        sp.set_color("#d9d6cf")
    fig.suptitle(f"{name}: {sum(cnt.values()):,} of {n:,} cells named by MapMyCells", fontsize=13, y=1.0)
    fig.savefig(out / f"{name}_celltypes_allen.png", dpi=112, facecolor="white", bbox_inches="tight")
    plt.close(fig)
    summary["allen_types"] = dict(cnt.most_common())

    # ---- Figure 3 C + D: MENDER tissue domains -----------------------------
    df = pd.read_parquet(args.mender_cells)
    x, y = df["native_x"].to_numpy(float), df["native_y"].to_numpy(float)
    dom = df["mender_domain"].astype(str).to_numpy()
    by_id = dict(zip(a.obs["instance_id"].astype(str), sup)) if "instance_id" in a.obs else {}
    sup_m = np.array([by_id.get(str(v), "") for v in df["cell_id"]])
    summary["mender_cells"] = int(len(df))
    summary["mender_cells_matched_to_mapmycells"] = int((sup_m != "").sum())
    sizes = collections.Counter(dom)
    min_size = max(10, int(0.015 * len(df)))  # 250 on a ~17,000-cell section
    keep = [d for d, k in sizes.most_common() if k >= min_size][:8]
    DCOL = {d: DOMAIN_PAL[i % len(DOMAIN_PAL)] for i, d in enumerate(keep)}
    fig, (axC, axD) = plt.subplots(1, 2, figsize=(16.4, 7.6), facecolor="white",
                                   gridspec_kw={"width_ratios": [1.85, 1.0], "wspace": 0.30})
    othd = ~np.isin(dom, keep)
    axC.scatter(x[othd], -y[othd], s=dot_size(len(df)), c="#d8d6d1", linewidths=0, rasterized=True)
    for d in keep:
        m = dom == d
        axC.scatter(x[m], -y[m], s=dot_size(len(df)) * 1.2, c=DCOL[d], linewidths=0, rasterized=True)
    axC.set_aspect("equal")
    axC.axis("off")
    axC.set_title("C · Tissue domains, from what surrounds each cell", fontsize=13, pad=10, loc="left")
    scale_bar(axC, x, y, "#6a6d70", "#4a4d50")
    axC.legend(handles=[Line2D([], [], marker="o", ls="", ms=7.5, color=DCOL[d], label="domain " + d) for d in keep]
               + ([Line2D([], [], marker="o", ls="", ms=7.5, color="#d8d6d1", label="smaller")] if othd.any() else []),
               loc="upper left", bbox_to_anchor=(0, 0.0), ncol=3, frameon=False, fontsize=9)
    ys = np.arange(len(keep))[::-1]
    domains = {}
    for i, d in enumerate(keep):
        m = dom == d
        s = collections.Counter(v for v in sup_m[m] if v)
        lead, k = s.most_common(1)[0] if s else ("—", 0)
        frac = 100 * k / max(1, m.sum())
        axD.barh(ys[i], sizes[d], height=0.62, color=DCOL[d])
        axD.text(sizes[d] * 1.02, ys[i], f"{sizes[d]:,}   {lead[:22]} {frac:.0f}%", va="center", fontsize=9)
        domains[d] = {"cells": int(m.sum()), "top_types": s.most_common(3)}
    axD.set_yticks(ys)
    axD.set_yticklabels(["domain " + d for d in keep], fontsize=9.5)
    axD.set_xlabel("cells in the domain")
    if keep:
        axD.set_xlim(0, max(sizes[d] for d in keep) * 2.5)
    axD.set_title("D · Size, and the type that dominates it", fontsize=13, pad=10, loc="left")
    axD.grid(True, axis="x", color="#e6e4e0", lw=0.7)
    axD.set_axisbelow(True)
    for sp in axD.spines.values():
        sp.set_color("#d9d6cf")
    fig.suptitle(f"{name}: {len(sizes)} MENDER domains over {len(df):,} cells", fontsize=13, y=1.0)
    fig.savefig(out / f"{name}_tissue_domains.png", dpi=112, facecolor="white", bbox_inches="tight")
    plt.close(fig)
    summary["mender_domains"] = domains

    (out / f"{name}_annotation_summary.json").write_text(json.dumps(summary, indent=1, default=str) + "\n")
    print(json.dumps({k: v for k, v in summary.items() if k != "mender_domains"}, default=str))


if __name__ == "__main__":
    main()
