// Registry images for the docker and singularity profiles. Four images,
// because some stages pin software that cannot share one environment:
//
//   merxen                 every stage not listed below   containers/Dockerfile
//   merxen-alignment       ALIGN, MATERIALIZE_ALIGNMENT   containers/Dockerfile.alignment
//   merxen-mender          MENDER_COMPUTE                 containers/Dockerfile.mender
//   merxen-clustering-gpu  CLUSTERING_SQUIDPY_COMPUTE,    containers/Dockerfile.clustering-gpu
//                          when clustering_squidpy_use_gpu
//
// The images are named <container_registry>/<image>:<container_tag>; build and
// push them as in docs/containers.md. Every stage gets its files as Nextflow
// inputs, so nothing outside the task folder needs to be mounted.

conda.enabled = false

// VALIS is installed in the alignment image, so ALIGN needs no network.
params.alignment_bootstrap_dependencies = false

process {
    container = "${params.container_registry}/merxen:${params.container_tag}"

    withName: "ALIGN|MATERIALIZE_ALIGNMENT" {
        container = "${params.container_registry}/merxen-alignment:${params.container_tag}"
    }
    withName: "MENDER_COMPUTE" {
        container = "${params.container_registry}/merxen-mender:${params.container_tag}"
    }
    withName: "CLUSTERING_SQUIDPY_COMPUTE" {
        container = {
            params.clustering_squidpy_use_gpu
                ? "${params.container_registry}/merxen-clustering-gpu:${params.container_tag}"
                : "${params.container_registry}/merxen:${params.container_tag}"
        }
    }
}
