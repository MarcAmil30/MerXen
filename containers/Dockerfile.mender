FROM condaforge/miniforge3:24.7.1-0

COPY envs/environment.mender.yml /tmp/environment.mender.yml
RUN conda env create -f /tmp/environment.mender.yml && conda clean --all --yes

WORKDIR /opt/merxen
COPY src ./src

ENV PATH=/opt/conda/envs/merxen-mender/bin:$PATH \
    PYTHONPATH=/opt/merxen/src \
    CUDA_VISIBLE_DEVICES=""

# Fallback cache folders (pynndescent compiles with numba): a non-root
# container user usually has no writable home. The MENDER processes point both
# at the task folder.
ENV MPLCONFIGDIR=/tmp/matplotlib \
    NUMBA_CACHE_DIR=/tmp/numba \
    XDG_CACHE_HOME=/tmp/.cache

CMD ["python"]
