# CUDA 12.9 to match the RAPIDS wheels pip resolves (26.6, built for CUDA
# 12.9): with the older 12.3.2-cudnn9 base, its libcudart is found first and
# cuML fails to load ("libcuml.so: cannot open shared object file").
FROM nvidia/cuda:12.9.1-devel-rockylinux9

RUN dnf install -y python3.12 python3.12-pip && dnf clean all
RUN ln -s /usr/bin/python3.12 /usr/local/bin/python3 && \
    ln -s /usr/bin/python3.12 /usr/local/bin/python

RUN python3 -m pip install --no-cache-dir \
    --extra-index-url=https://pypi.nvidia.com \
    "rapids-singlecell-cu12[rapids]==0.15.2" \
    "anndata>=0.10.9,<0.13.0" \
    "scanpy>=1.10" \
    "matplotlib>=3.8" \
    "seaborn>=0.13" \
    "scipy>=1.12" \
    "pandas>=2.0" \
    "numpy>=1.24,<3" \
    "python-igraph>=0.11" \
    "leidenalg>=0.10" \
    "pydantic>=2.0" \
    "pydantic-settings>=2.0" \
    "psutil>=5.9" \
    "tqdm>=4.60"

WORKDIR /opt/merxen
COPY src ./src
ENV PYTHONPATH=/opt/merxen/src

# Fallback cache folders: a non-root container user usually has no writable
# home. MerXen's own code points both at the task folder where it can.
ENV MPLCONFIGDIR=/tmp/matplotlib \
    NUMBA_CACHE_DIR=/tmp/numba \
    CUPY_CACHE_DIR=/tmp/cupy \
    XDG_CACHE_HOME=/tmp/.cache

CMD ["python3"]
